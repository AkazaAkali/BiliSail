#!/usr/bin/env bash
# Keep Flutter's executable/lib/data layout together in both package formats.
set -e
export APPDIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
export LD_LIBRARY_PATH="$APPDIR/usr/bin/lib:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
for hook in "$APPDIR"/apprun-hooks/*.sh; do
  [[ -f "$hook" ]] && source "$hook"
done
exec "$APPDIR/usr/bin/bilisail" "$@"
