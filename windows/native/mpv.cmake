# Windows-only libmpv override. Never modify the shared Pub cache or other OSes.
set(BILISAIL_MPV_ROOT "${CMAKE_CURRENT_LIST_DIR}/mpv")

function(bilisail_use_pinned_mpv)
  set(version "20261012-git-88eb9f2e73")
  set(archive "mpv-dev-lgpl-x86_64-${version}.7z")
  set(sha256 "d1a3f57dfb3c7f07e5456e32e9ecc9e406f6457f2560ff5801c9b37a8036f507")
  set(url "https://github.com/zhongfly/mpv-winbuild/releases/download/2026-10-12-88eb9f2e73/${archive}")
  set(cache "${CMAKE_BINARY_DIR}/bilisail_native")
  set(source "${cache}/mpv-${version}")
  file(MAKE_DIRECTORY "${cache}" "${source}")
  if(NOT EXISTS "${cache}/${archive}")
    file(DOWNLOAD "${url}" "${cache}/${archive}.download"
      EXPECTED_HASH "SHA256=${sha256}" TLS_VERIFY ON STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "Pinned LGPL libmpv download failed: ${status}")
    endif()
    file(RENAME "${cache}/${archive}.download" "${cache}/${archive}")
  endif()
  file(SHA256 "${cache}/${archive}" actual)
  if(NOT actual STREQUAL sha256)
    message(FATAL_ERROR "Pinned LGPL libmpv archive hash mismatch")
  endif()
  if(NOT EXISTS "${source}/libmpv-2.dll")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${cache}/${archive}"
      WORKING_DIRECTORY "${source}" RESULT_VARIABLE extracted)
    if(NOT extracted EQUAL 0)
      message(FATAL_ERROR "Pinned LGPL libmpv extraction failed")
    endif()
  endif()
  foreach(required libmpv-2.dll libmpv.dll.a include/mpv/client.h
      include/mpv/render.h include/mpv/render_gl.h)
    if(NOT EXISTS "${source}/${required}")
      message(FATAL_ERROR "Pinned LGPL libmpv is incomplete: ${required}")
    endif()
  endforeach()
  file(SHA256 "${source}/libmpv-2.dll" dll_sha256)
  if(NOT dll_sha256 STREQUAL
      "222da57d12a47680df84a8d0ad06f713fbbce4da923784ddeebe9d666135e943")
    message(FATAL_ERROR "Pinned LGPL libmpv DLL hash mismatch")
  endif()
  # The plugin's implementation includes <client.h>/<render.h> directly.
  get_target_property(includes media_kit_video_plugin INCLUDE_DIRECTORIES)
  list(REMOVE_ITEM includes "${CMAKE_BINARY_DIR}/libmpv/include")
  list(PREPEND includes "${source}/include/mpv")
  set_property(TARGET media_kit_video_plugin PROPERTY INCLUDE_DIRECTORIES "${includes}")
  get_target_property(links media_kit_video_plugin LINK_LIBRARIES)
  list(FIND links "${CMAKE_BINARY_DIR}/libmpv/libmpv.dll.a" old_link)
  if(old_link LESS 0)
    message(FATAL_ERROR "media_kit_video libmpv link contract changed")
  endif()
  list(REMOVE_AT links ${old_link})
  list(APPEND links "${source}/libmpv.dll.a")
  set_property(TARGET media_kit_video_plugin PROPERTY LINK_LIBRARIES "${links}")
  list(FIND PLUGIN_BUNDLED_LIBRARIES "${CMAKE_BINARY_DIR}/libmpv/libmpv-2.dll" old_dll)
  if(old_dll LESS 0)
    message(FATAL_ERROR "media_kit_video libmpv bundle contract changed")
  endif()
  list(REMOVE_AT PLUGIN_BUNDLED_LIBRARIES ${old_dll})
  list(APPEND PLUGIN_BUNDLED_LIBRARIES "${source}/libmpv-2.dll")
  set(PLUGIN_BUNDLED_LIBRARIES "${PLUGIN_BUNDLED_LIBRARIES}" PARENT_SCOPE)
endfunction()
